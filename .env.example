# Copy to .env and fill in. NEVER commit .env — it holds live keys.
# Publish safety: pin the carsInShorts channel id so an upload aborts if the
# cached token ever points at the wrong channel (a Short once went up on the wrong one).
CARSHORTS_CHANNEL=UCtT7HC6Jcetn2d5QBx8UktA
# DeepSeek is the primary text model (paid, ~₹150/mo at 3 videos/day). Get a key
# at platform.deepseek.com; it leads the LLM chain automatically when set.
DEEPSEEK_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
PEXELS_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
