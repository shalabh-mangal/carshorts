# Python
.venv/
.venv-video/
venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Workspace — ALL generated/regenerable artifacts (AI clips, voice cache, logs).
# Sprint 0 moved assets/gen/, data/logs/, out/tts_cache/ under here.
workspace/
# provenance ledger (record of what's AI-generated) stays in data/ but gitignored
data/gen_provenance.json
# AI-generated Living Stills (regenerable via `carshorts liven`; tracked in the
# provenance ledger, not the committed real-asset pool)
**/own/living_*.mp4

# Secrets — never commit API keys
.env
env
*.key

# Generated renders (regenerable; finals live on YouTube)
out/
# one oversized archive clip exceeds GitHub's 100MB hard limit
assets/stock_archive/
# curated asset pool (assets/) IS committed — licensed content + credits
# are part of the system's knowledge; renders are not

# Harness output
harness_report.json

# Runtime logs (scheduled-task output)
data/logs/

# Quarantined assets — plates/watermarks/wrong-vehicle, kept locally for
# recovery but never committed to the clean licensed pool
**/_quarantine/
**/_quarantine_plated/

# Inbox is a transient drop/working area — ingest moves good files into the pool
assets/inbox/
# Rejected third-party/ripped content (e.g. brand ad rips) — kept locally for
# reference, NEVER committed (copyright)
assets/inbox_rejected/

# Editor
.idea/
.vscode/
.DS_Store

